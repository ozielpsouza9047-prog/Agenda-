# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================================
# SUPABASE CONFIGURATION (PERSISTÊNCIA E AUTENTICAÇÃO REAL)
# ==========================================================
# URL pública do projeto Supabase (ex: https://ihjpxxlotdmxvrccbukf.supabase.co)
VITE_SUPABASE_URL="https://ihjpxxlotdmxvrccbukf.supabase.co"

# Chave pública do Supabase (Project Settings > API > anon public ou sb_publishable_)
# Acessível no frontend pelo Vite via import.meta.env.VITE_SUPABASE_ANON_KEY
# Respeita estritamente as políticas RLS do Supabase.
VITE_SUPABASE_ANON_KEY="sb_publishable_..."

# Chave secreta / Service Role do Supabase (sb_secret_... ou service_role)
# CRÍTICO: NUNCA adicionar prefixo VITE_ nesta variável!
# Apenas para scripts/backend em Node.js. Ignorada pelo bundle do navegador.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

